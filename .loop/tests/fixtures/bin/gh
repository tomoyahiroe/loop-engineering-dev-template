#!/usr/bin/env bash
# テスト用の gh スタブ。呼び出しを $GH_LOG に記録し、$GH_* 環境変数で応答を決める
set -uo pipefail
[ -n "${GH_LOG:-}" ] && echo "$*" >> "$GH_LOG"

# 既定の JSON は必ず変数に入れてから ${VAR:-$DEFAULT} の形で使う。
# ${VAR:-{"a":"b"}} のように波括弧を直接書くと、VAR が設定されているときだけ
# 末尾に余分な } が付いて JSON が壊れる（bash 3.2 / 5.3 の両方で再現）
DEFAULT_ISSUE_JSON='{"body":"","state":"OPEN"}'
DEFAULT_PR_VIEW_JSON='{}'

# set -u 下で単独引数（gh --version 等）でも落ちないよう既定値を付ける
case "${1:-} ${2:-}" in
  "issue view")
    if [ "${3:-}" = "--json" ] || [ "${4:-}" = "--json" ]; then
      echo "${GH_ISSUE_JSON:-$DEFAULT_ISSUE_JSON}"
    fi
    ;;
  "issue list")
    # 既定は完全にステートレス（GH_ISSUE_LIST_JSON をそのまま返すだけ）。
    # GH_STATE_DIR を指定したテストだけ、以前の "issue edit ... --remove-label
    # loop:ready" 成功が反映された一覧を返す（実際の GitHub は remove-label が
    # 成功すれば以後 --label loop:ready の一覧に出てこなくなるため。これが
    # ないと、複数 tick に渡るテストが「remediate 済みで消えた」のか
    # 「まだ ready でリトライ中」なのかを区別できない）
    if [ -n "${GH_STATE_DIR:-}" ]; then
      printf '%s' "${GH_ISSUE_LIST_JSON:-[]}" | node -e '
let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
  try{
    const fs=require("fs");
    const dir=process.env.GH_STATE_DIR;
    const a=JSON.parse(s);
    const out=a.filter(x=>!fs.existsSync(dir+"/removed-"+x.number));
    process.stdout.write(JSON.stringify(out));
  }catch{process.stdout.write("[]")}
})'
    else
      echo "${GH_ISSUE_LIST_JSON:-[]}"
    fi
    ;;
  # remove-label / add-label はどちらも "issue edit" に落ちるので、片方だけを
  # 狙って失敗させることはできない（firing の「両方失敗し続ける」ケースの
  # テストにはこれで十分。個別に落としたければ引数まで見て分岐を増やす）
  "issue edit")
    RC="${GH_ISSUE_EDIT_EXIT:-${GH_EXIT:-0}}"
    # remove-label loop:ready が「成功」したときだけ、GH_STATE_DIR に印を
    # 残す（issue list 側がこれを見て以後の一覧から除外する）
    if [ "$RC" = 0 ] && [ -n "${GH_STATE_DIR:-}" ] \
       && [ "${4:-}" = "--remove-label" ] && [ "${5:-}" = "loop:ready" ]; then
      touch "$GH_STATE_DIR/removed-${3:-}"
    fi
    exit "$RC"
    ;;
  "issue comment") exit "${GH_ISSUE_COMMENT_EXIT:-${GH_EXIT:-0}}" ;;
  "pr list")    echo "${GH_PR_LIST_JSON:-[]}" ;;
  "pr view")    echo "${GH_PR_VIEW_JSON:-$DEFAULT_PR_VIEW_JSON}" ;;
  # pr merge だけを狙って失敗させたいテスト向けの選択的ノブ。GH_EXIT は
  # 全コマンドに効いてしまい、firing の "pr merge" より前に呼ばれる
  # "issue list" / "pr list" まで巻き込んで壊すため、pr merge の失敗経路
  # 単体をテストできない。未指定時は既定どおり GH_EXIT にフォールバックする
  # ので、これを使わない既存テストの挙動は一切変わらない
  "pr merge")   exit "${GH_PR_MERGE_EXIT:-${GH_EXIT:-0}}" ;;
  *) ;;
esac
exit "${GH_EXIT:-0}"
